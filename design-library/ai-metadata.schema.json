{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:estilos:ai-metadata:v1",
  "title": "Metadatos de IA por bloque v1",
  "type": "object",
  "required": ["schema_version", "blocks"],
  "properties": {
    "schema_version": { "const": 1 },
    "note": { "type": "string" },
    "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
  },
  "$defs": {
    "slot": {
      "type": "object",
      "required": ["name", "kind", "selector"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "kind": { "enum": ["text", "textlist", "color", "image", "link"] },
        "selector": { "type": "string", "minLength": 1, "description": "Selector CSS dentro del HTML del bloque." },
        "max": { "type": "integer", "minimum": 1, "description": "Longitud máxima por texto." },
        "count": { "type": "integer", "minimum": 1, "description": "Elementos esperados en un textlist." },
        "required": { "type": "boolean" }
      }
    },
    "block": {
      "type": "object",
      "required": ["id", "slots", "rules", "ai"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "Debe existir en catalog.json." },
        "slots": { "type": "array", "items": { "$ref": "#/$defs/slot" } },
        "rules": {
          "type": "object",
          "required": ["role", "position", "max_per_screen"],
          "additionalProperties": false,
          "properties": {
            "role": { "enum": ["header", "cards", "actions", "nav"] },
            "position": { "enum": ["top", "body", "bottom"] },
            "max_per_screen": { "type": "integer", "minimum": 1 },
            "pairs_with": { "type": "array", "items": { "type": "string" } },
            "conflicts_with": { "type": "array", "items": { "type": "string" } }
          }
        },
        "ai": {
          "type": "object",
          "required": ["when_to_use", "avoid_when"],
          "additionalProperties": false,
          "properties": {
            "when_to_use": { "type": "string", "minLength": 10 },
            "avoid_when": { "type": "string", "minLength": 10 }
          }
        }
      }
    }
  }
}
